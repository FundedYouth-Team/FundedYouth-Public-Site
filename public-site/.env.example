# Server-only variables for Cloudflare Pages Functions (functions/api/).
# These are NOT exposed to the browser — do not add a VITE_ prefix.
# Set them in: Cloudflare Pages → Settings → Environment variables.

# Required by functions/api/sponsor.ts. Sponsor applications fail with a
# 500 until this is set. Store as an encrypted secret, never plaintext.
RESEND_API_KEY=

# Optional overrides. Defaults are in functions/api/sponsor.ts.
# SPONSOR_TO=info@fundedyouth.org
# SPONSOR_FROM=FundedYouth Website <noreply@fundedyouth.org>
